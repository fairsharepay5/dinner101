# Copy this file to .env and fill in what you have. Everything works in the simulator with none of it.

# --- General ---
PUBLIC_BASE_URL=https://dinner101.co.za      # where this server is reachable (needed for photos + PayFast)
DATABASE_URL=sqlite:///./dinner101.db        # fine to start; use Postgres later (postgresql+psycopg://...)
TIMEZONE=Africa/Johannesburg
ADMIN_KEY=pick-a-long-random-password
DATA_DIR=./data
SIMULATOR_ENABLED=1                          # set to 0 in production
RUN_SCHEDULER=1

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=dinner101-verify
WHATSAPP_DISPLAY_NUMBER=2782XXXXXXX           # the number people message, no + or spaces
WA_TEMPLATE_DINNER=dinner_tonight
WA_TEMPLATE_CHECKIN=dinner_checkin
WA_TEMPLATE_NOTICE=account_notice

# --- AI ---
ANTHROPIC_API_KEY=                           # reads slips + understands voice notes (English/Afrikaans)
PARSE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=                              # voice-note transcription + recipe photos
TRANSCRIBE_MODEL=whisper-1
IMAGE_MODEL=gpt-image-1

# --- Billing (PayFast) ---
PRICE_RANDS=39
TRIAL_DAYS=14
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=1

# --- Behaviour ---
DEFAULT_DINNER_TIME=16:30
CHECKIN_AFTER_HOURS=2.5
